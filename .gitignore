# Exclude non-robot project contents (keep empty folders via .gitkeep)
2_room_thermostat/*
!2_room_thermostat/.gitkeep

3_circular_building/*
!3_circular_building/.gitkeep

# Exclude figures, documentation, and MATLAB reference code
figures/
docs/
matlab_reference/
*.pdf

# Exclude non-robot root scripts
main.py
gui_heat.py
gui_building.py
run_benchmarks.py
run_gui.bat

# Python bytecode and temporary files
__pycache__/
*.py[cod]
*$py.class
*.log
